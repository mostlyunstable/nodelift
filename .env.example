# Copy to .env (never commit .env)
NODECRAFT_HOST=127.0.0.1
NODECRAFT_PORT=8000
# NODECRAFT_DATA_DIR=~/.nodecraft

# `make dev` generates a random NODECRAFT_API_TOKEN for you. Set one yourself only when running the
# API alone; when set, every route except /api/v1/health requires "Authorization: Bearer <token>".
# NODECRAFT_API_TOKEN=

# Request gatekeeping (defaults shown). Requests with another Host header, or a browser Origin that
# is not listed, are rejected (this blocks DNS-rebinding and cross-site requests).
# NODECRAFT_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# NODECRAFT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limits
# NODECRAFT_MAX_CONCURRENT_RUNS=4
# NODECRAFT_MAX_CONCURRENT_NODE_TESTS=4
# NODECRAFT_MAX_RUN_SECONDS=300

# Dev only
# NODECRAFT_RELOAD=1            # auto-reload; its child process can outlive Ctrl+C (run `make stop`)
# NODECRAFT_HTTP_ALLOW_PRIVATE=1  # let http.request reach localhost/LAN
# NODECRAFT_ALLOW_UNSAFE_REMOTE=1 # DANGEROUS: code nodes are not sandboxed; also requires NODECRAFT_API_TOKEN
